      "css": ".ds-search{font-family:var(--texte);display:flex;gap:8px;align-items:center;height:36px;min-width:180px;width:280px;border:1px solid var(--trait-fort);border-radius:6px;background:var(--panneau);padding:0 10px;color:var(--encre-3)}.ds-search input{font-family:var(--texte);min-width:0;width:100%;border:0;outline:0;background:none;font-size:13px;color:var(--encre)}.ds-search:focus-within{outline:2px solid var(--menthe);outline-offset:3px}.ds-search input::placeholder{color:var(--encre-3)}"
