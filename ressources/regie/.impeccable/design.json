      "name": "Bouton action",
      "kind": "button",
      "refersTo": "button-action",
      "description": "Action secondaire standard du Studio.",
      "html": "<button class=\"ds-action\">Aujourd’hui</button>",
      "css": ".ds-action{font-family:var(--texte);border:1px solid var(--trait-fort);border-radius:6px;background:var(--panneau);color:var(--encre);padding:8px 10px;font-size:12px;min-height:36px;cursor:pointer}.ds-action:hover:not(:disabled){background:var(--releve)}.ds-action:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}.ds-action:disabled{cursor:wait;opacity:.6}"
    },
    {
      "name": "Bouton segment",
