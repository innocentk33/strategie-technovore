      "html": "<div class=\"ds-segments\"><button aria-pressed=\"true\">Kanban</button><button aria-pressed=\"false\">Liste</button></div>",
      "css": ".ds-segments{display:inline-flex;padding:3px;background:var(--releve);border-radius:7px;gap:2px}.ds-segments button{font-family:var(--texte);background:none;border:0;border-radius:5px;padding:7px 11px;font-size:12px;cursor:pointer;color:var(--encre-3)}.ds-segments button[aria-pressed=\"true\"]{background:var(--panneau);color:var(--encre);box-shadow:0 2px 4px #0001;font-weight:600}.ds-segments button:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
